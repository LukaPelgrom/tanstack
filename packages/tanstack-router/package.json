{
  "name": "@nativescript/tanstack-router",
  "version": "0.2.0-solid.1",
  "description": "TanStack Router for NativeScript",
  "main": "index.cjs",
  "types": "index.d.ts",
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "solid",
    "nativescript.vite.mjs",
    "nativescript.webpack.js",
    "solid-web-shim.js",
    "solid-js-jsx-runtime-shim.js",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.mjs"
    },
    "./solid": {
      "types": "./solid/index.d.ts",
      "import": "./solid/index.mjs",
      "require": "./solid/index.cjs",
      "default": "./solid/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "nativescript": {
    "platforms": {
      "ios": "6.0.0",
      "android": "6.0.0"
    }
  },
  "scripts": {
    "clean": "rm -rf ../../dist/packages/tanstack-router",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && npm run typecheck && tsup --config tsup.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build:git",
    "build:git": "tsup --config tsup.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LukaPelgrom/tanstack.git"
  },
  "keywords": [
    "NativeScript",
    "JavaScript",
    "TypeScript",
    "iOS",
    "Android",
    "TanStack Router",
    "SolidJS"
  ],
  "author": {
    "name": "NativeScript",
    "email": "oss@nativescript.org"
  },
  "bugs": {
    "url": "https://github.com/NativeScript/tanstack/issues"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/NativeScript/tanstack",
  "readmeFilename": "README.md",
  "dependencies": {
    "@tanstack/router-plugin": "1.168.35",
    "@tanstack/router-core": "1.171.22",
    "dominative": "0.1.3"
  },
  "peerDependencies": {
    "@nativescript-community/solid-js": ">=2.0.0-0 <3.0.0",
    "@nativescript/core": ">=9.0.0",
    "@tanstack/history": "1.162.1",
    "@tanstack/router-core": "1.171.22",
    "@tanstack/solid-router": "2.0.0-rc.4",
    "@types/node": "^24.0.0",
    "solid-js": ">=2.0.0-0 <3.0.0"
  },
  "devDependencies": {
    "@nativescript-community/solid-js": "2.0.0-rc.0",
    "@nativescript/core": "9.1.1",
    "@nativescript/types-ios": "9.1.1",
    "@tanstack/history": "1.162.1",
    "@tanstack/solid-router": "2.0.0-rc.4",
    "dominative": "0.1.3",
    "solid-js": "2.0.0-rc.5",
    "tsup": "^8.3.5",
    "typescript": "~5.9.0",
    "vitest": "^4.1.5"
  }
}
